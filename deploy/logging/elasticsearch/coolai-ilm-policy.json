# ============================================================
# Elasticsearch ILM 策略 - CoolAI 日志索引生命周期
# ============================================================
# 
# 自动管理日志索引的滚动和清理
# - 滚动条件：索引大小 >= 50GB 或 年龄 >= 30天
# - 删除条件：年龄 >= 90天
# 
# 初始化命令（首次部署时执行）:
# curl -X PUT "http://localhost:9200/_ilm/policy/coolai-log-policy" -H 'Content-Type: application/json' -d @coolai-ilm-policy.json
#
# Author: CoolAI Team
# Date: 2026-05-13
# ============================================================

{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_size": "50gb",
            "max_age": "30d"
          },
          "set_priority": {
            "priority": 100
          }
        }
      },
      "warm": {
        "min_age": "7d",
        "actions": {
          "forcemerge": {
            "max_num_segments": 1
          },
          "shrink": {
            "number_of_shards": 1
          },
          "allocate": {
            "number_of_replicas": 0
          },
          "set_priority": {
            "priority": 50
          }
        }
      },
      "cold": {
        "min_age": "30d",
        "actions": {
          "freeze": {},
          "set_priority": {
            "priority": 0
          }
        }
      },
      "delete": {
        "min_age": "90d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
